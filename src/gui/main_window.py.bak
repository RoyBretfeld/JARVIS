            internet_layout.addLayout(options_layout)
            
            # Bereit & Ergebnis Labels
            bereit_label = QLabel("Bereit")
            ergebnis_label = QLabel("Ergebnis")
            internet_layout.addWidget(bereit_label)
            internet_layout.addWidget(ergebnis_label)
            
            # Speichern & Löschen Buttons
            button_layout = QHBoxLayout()
            save_btn = QPushButton("Speichern")
            delete_btn = QPushButton("Löschen")
            button_layout.addWidget(save_btn)
            button_layout.addWidget(delete_btn)
            internet_layout.addLayout(button_layout)
            
            right_column.addWidget(internet_group)
            
            # Füge die Spalten zum content_layout hinzu
            content_layout.addLayout(left_column, 1)      # 1/4 der Breite
            content_layout.addLayout(middle_column, 2)    # 2/4 der Breite
            content_layout.addLayout(right_column, 1)     # 1/4 der Breite
            
            # Füge content_layout zum main_layout hinzu
            main_layout.addLayout(content_layout)
            
            # Statusleiste am unteren Rand
            status_bar = QStatusBar()
            self.setStatusBar(status_bar)
            
            # CPU, RAM, GPU Status Labels erstellen
            status_widget = QWidget()
            status_layout = QHBoxLayout(status_widget)
            
            self.cpu_label = QLabel("CPU: --%")
            self.ram_label = QLabel("RAM: --%")
            self.gpu_label = QLabel("GPU: --%")
            self.model_label = QLabel("Modell: --")
            self.db_label = QLabel("DB: -- MB")
            
            status_layout.addWidget(self.cpu_label)
            status_layout.addWidget(QLabel("|"))
            status_layout.addWidget(self.ram_label)
            status_layout.addWidget(QLabel("|"))
            status_layout.addWidget(self.gpu_label)
            status_layout.addWidget(QLabel("|"))
            status_layout.addWidget(self.model_label)
            status_layout.addWidget(QLabel("|"))
            status_layout.addWidget(self.db_label)
            
            status_bar.addPermanentWidget(status_widget)
            
            # Signal-Verbindungen
            mic_select_btn.clicked.connect(self.show_mic_selector)
            self.record_btn.clicked.connect(self.toggle_recording)
            file_import_btn.clicked.connect(self.import_files)
            audiobook_import_btn.clicked.connect(self.import_audiobook)
            thumbs_up_btn.clicked.connect(lambda: self.send_feedback(True))
            thumbs_down_btn.clicked.connect(lambda: self.send_feedback(False))
            prompt_edit_btn.clicked.connect(self.show_prompt_editor)
            
            # Speichere wichtige UI-Elemente als Instanzvariablen
            self.whisper_status = whisper_status
            self.llm_combo = llm_combo
            self.model_combo = model_combo
            self.mic_status = self.mic_status
            self.record_btn = self.record_btn
            self.db_status = db_status
            self.thumbs_up_btn = thumbs_up_btn
            self.thumbs_down_btn = thumbs_down_btn
            
            # Deaktiviere Feedback-Buttons initial
            self.thumbs_up_btn.setEnabled(False)
            self.thumbs_down_btn.setEnabled(False)
            
        except Exception as e:
            logger.error(f"Fehler beim Initialisieren der UI: {e}", exc_info=True)
            raise

    def init_whisper(self):
        """Initialisiert den Whisper Recognizer."""
        try:
            logger.info("Initialisiere Whisper Recognizer...")
            # Starte den Ladevorgang im Hintergrund
            self.model_loader = ModelLoaderThread(self)
            self.model_loader.finished.connect(self.on_whisper_loaded)
            self.model_loader.error.connect(self.on_whisper_error)
            self.model_loader.start()
            
            # Aktualisiere UI-Status
            self.whisper_status.setText("Whisper: Wird geladen...")
            self.whisper_status.setStyleSheet("color: #ffaa00;")  # Orange für "Wird geladen"
            
        except Exception as e:
            logger.error(f"Fehler bei der Whisper-Initialisierung: {e}")
            self.whisper_status.setText("Whisper: Fehler")
            self.whisper_status.setStyleSheet("color: #ff0000;")  # Rot für Fehler
            
    def on_whisper_loaded(self, recognizer):
        """Wird aufgerufen, wenn Whisper erfolgreich geladen wurde."""
        try:
            self.whisper_recognizer = recognizer
            self.whisper_status.setText("Whisper: Bereit")
            self.whisper_status.setStyleSheet("color: #00ff00;")  # Grün für "Bereit"
            logger.info("Whisper Recognizer erfolgreich initialisiert")
        except Exception as e:
            logger.error(f"Fehler beim Setzen des Whisper Recognizers: {e}")
            
    def on_whisper_error(self, error_msg: str):
        """Wird aufgerufen, wenn beim Laden von Whisper ein Fehler auftritt."""
        self.whisper_status.setText("Whisper: Fehler")
        self.whisper_status.setStyleSheet("color: #ff0000;")  # Rot für Fehler
        logger.error(f"Fehler beim Laden von Whisper: {error_msg}")

    def init_llama(self):
        # Implementiere die Initialisierung von LLaMA
        pass

    def load_saved_microphone(self):
        """Lädt die gespeicherte Mikrofonkonfiguration."""
        try:
            # Versuche gespeicherten Mikrofonindex aus der Konfiguration zu laden
            saved_index = self.config.get('audio', 'microphone_index', fallback=None)
            
            if saved_index is not None:
                try:
                    saved_index = int(saved_index)
                    # Prüfe ob das gespeicherte Mikrofon noch verfügbar ist
                    p = pyaudio.PyAudio()
                    try:
                        device_info = p.get_device_info_by_index(saved_index)
                        if device_info.get('maxInputChannels') > 0:
                            self.selected_mic_index = saved_index
                            self.mic_status.setText(f"Mikrofon ({device_info['name']})")
                            self.mic_status.setStyleSheet("color: #00ff00;")  # Grün für aktives Mikrofon
                            logger.info(f"Gespeichertes Mikrofon geladen: {device_info['name']}")
                            return
                    except Exception as e:
                        logger.warning(f"Gespeichertes Mikrofon (Index {saved_index}) nicht mehr verfügbar: {e}")
                    finally:
                        p.terminate()
                except ValueError:
                    logger.warning(f"Ungültiger Mikrofonindex in Konfiguration: {saved_index}")
            
            # Wenn kein Mikrofon gespeichert oder nicht mehr verfügbar,
            # versuche das Standardmikrofon zu finden
            self.select_default_microphone()
            
        except Exception as e:
            logger.error(f"Fehler beim Laden der Mikrofonkonfiguration: {e}")
            self.mic_status.setText("Kein Mikrofon ausgewählt")
            self.mic_status.setStyleSheet("color: #ff0000;")  # Rot für Fehler
            
    def select_default_microphone(self):
        """Wählt das Standardmikrofon aus."""
        try:
            p = pyaudio.PyAudio()
            try:
                # Suche nach dem Standardeingabegerät
                default_index = p.get_default_input_device_info()['index']
                device_info = p.get_device_info_by_index(default_index)
                
                if device_info.get('maxInputChannels') > 0:
                    self.selected_mic_index = default_index
                    self.mic_status.setText(f"Mikrofon ({device_info['name']})")
                    self.mic_status.setStyleSheet("color: #00ff00;")  # Grün für aktives Mikrofon
                    logger.info(f"Standardmikrofon ausgewählt: {device_info['name']}")
                    
                    # Speichere die Auswahl in der Konfiguration
                    self.config.set('audio', 'microphone_index', str(default_index))
                    return
                    
            except Exception as e:
                logger.warning(f"Konnte Standardmikrofon nicht finden: {e}")
                
            # Wenn Standardmikrofon nicht verfügbar, suche nach dem ersten verfügbaren Mikrofon
            for i in range(p.get_device_count()):
                try:
                    device_info = p.get_device_info_by_index(i)
                    if device_info.get('maxInputChannels') > 0:
                        self.selected_mic_index = i
                        self.mic_status.setText(f"Mikrofon ({device_info['name']})")
                        self.mic_status.setStyleSheet("color: #00ff00;")  # Grün für aktives Mikrofon
                        logger.info(f"Erstes verfügbares Mikrofon ausgewählt: {device_info['name']}")
                        
                        # Speichere die Auswahl in der Konfiguration
                        self.config.set('audio', 'microphone_index', str(i))
                        return
                except:
                    continue
                    
            # Wenn kein Mikrofon gefunden wurde
            raise Exception("Kein funktionierendes Mikrofon gefunden")
            
        except Exception as e:
            logger.error(f"Fehler bei der Mikrofonauswahl: {e}")
            self.mic_status.setText("Kein Mikrofon verfügbar")
            self.mic_status.setStyleSheet("color: #ff0000;")  # Rot für Fehler
            self.selected_mic_index = None
        finally:
            if 'p' in locals():
                p.terminate()
                
    def show_mic_selector(self):
        """Zeigt den Dialog zur Mikrofonauswahl."""
        try:
            selector = MicrophoneSelector(self)
            if selector.exec() == QDialog.DialogCode.Accepted:
                selected_mic = selector.get_selected_microphone()
                if selected_mic is not None:
                    # Speichere den ausgewählten Mikrofon-Index
                    self.selected_mic_index = selected_mic
                    
                    # Hole Geräteinformationen
                    p = pyaudio.PyAudio()
                    try:
                        device_info = p.get_device_info_by_index(selected_mic)
                        # Aktualisiere Mikrofon-Status
                        self.mic_status.setText(f"Mikrofon ({device_info['name']})")
                        self.mic_status.setStyleSheet("color: #00ff00;")  # Grün für aktives Mikrofon
                        logger.info(f"Neues Mikrofon ausgewählt: {device_info['name']}")
                        
                        # Speichere die Auswahl in der Konfiguration
                        self.config.set('audio', 'microphone_index', str(selected_mic))
                    finally:
                        p.terminate()
                        
        except Exception as e:
            logger.error(f"Fehler bei der Mikrofonauswahl: {e}")
            QMessageBox.critical(self, "Fehler", f"Fehler bei der Mikrofonauswahl:\n{e}")
            self.mic_status.setText("Fehler bei Mikrofonauswahl")
            self.mic_status.setStyleSheet("color: #ff0000;")  # Rot für Fehler

    def update_status(self):
        """Aktualisiert die Systemstatus-Anzeige."""
        try:
            # CPU Auslastung
            cpu_percent = psutil.cpu_percent()
            self.cpu_label.setText(f"CPU: {cpu_percent}%")
            
            # RAM Auslastung
            ram = psutil.virtual_memory()
            self.ram_label.setText(f"RAM: {ram.percent}%")
            
            # Datenbank Größe
            db_size = get_directory_size("data/knowledge_base/chroma_db") / 1024  # Konvertiere zu MB
            self.db_label.setText(f"DB: {db_size:.1f} MB")
            
            # Aktives Modell - Sicherere Implementierung
            if self.llm_manager and hasattr(self.llm_manager, 'current_provider'):
                if hasattr(self.llm_manager.current_provider, 'model_name'):
                    model_name = self.llm_manager.current_provider.model_name
                else:
                    model_name = "llama3:8b"  # Fallback zum bekannten Modellnamen
                self.model_label.setText(f"Modell: {model_name}")
            else:
                self.model_label.setText("Modell: --")
                
        except Exception as e:
            logger.error(f"Fehler beim Aktualisieren des Status: {e}")
            # Setze Standardwerte im Fehlerfall
            self.cpu_label.setText("CPU: --")
            self.ram_label.setText("RAM: --")
            self.model_label.setText("Modell: --")
            self.db_label.setText("DB: --")

    def update_db_size_display(self):
        """Aktualisiert die Anzeige der Datenbank-Größe."""
        try:
            # Hole die aktuellen Werte
            db_size = get_directory_size("data/knowledge_base/chroma_db") / 1024  # Konvertiere zu MB
            
            # Hole die Anzahl der Einträge direkt aus der Collection
            if self.learning_manager and hasattr(self.learning_manager, 'collection'):
                total_entries = len(self.learning_manager.collection.get(
                    include=[],
                    limit=10000000  # Hoher Wert um alle Einträge zu bekommen
                )['ids'])
                
                # Zähle die verschiedenen Typen
                conversation_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "conversation"},
                    include=[]
                )['ids'])
                
                response_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "response"},
                    include=[]
                )['ids'])
                
                audio_transcript_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "audio_transcript_chunk"},
                    include=[]
                )['ids'])
                
                audiobook_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "audiobook_chunk"},
                    include=[]
                )['ids'])
                
                document_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "document_chunk"},
                    include=[]
                )['ids'])
                
                # Aktualisiere beide Anzeigen mit dem gleichen Wert
                status_text = f"Datenbank: {db_size:.2f} MB | {total_entries} Einträge | conversation: {conversation_count} | response: {response_count} | audio_transcript_chunk: {audio_transcript_count} | audiobook_chunk: {audiobook_count} | document_chunk: {document_count}"
                self.db_status.setText(status_text)
                self.db_label.setText(f"DB: {db_size:.2f} MB")
            else:
                self.db_status.setText("Datenbank nicht verfügbar")
                self.db_label.setText("DB: --")
            
        except Exception as e:
            logger.error(f"Fehler beim Aktualisieren der Datenbank-Größe: {e}")
            self.db_status.setText("Fehler beim Laden der Datenbank-Statistiken")
            self.db_label.setText("DB: Fehler")

