    def start_webscraping(self):
        """Startet den Webscraping-Prozess für die eingegebene URL."""
        try:
            url = self.url_input.text().strip()
            if not url:
                QMessageBox.warning(self, "Fehler", "Bitte geben Sie eine URL ein.")
                return
                
            # Hier würde der eigentliche Webscraping-Code stehen
            # Für jetzt nur eine Platzhalter-Nachricht
            self.scraping_results.append(f"Scraping gestartet für: {url}")
            self.scraping_results.append("Diese Funktion ist noch in Entwicklung...")
            
        except Exception as e:
            logger.error(f"Fehler beim Webscraping: {e}")
            QMessageBox.critical(self, "Fehler", f"Ein Fehler ist beim Webscraping aufgetreten:\n{e}")

    def update_weather(self):
        """Aktualisiert die Wetterinformationen."""
        try:
            current_time = QDateTime.currentDateTime().toString("HH:mm")
            self.time_label.setText(f"⌚ Zeit: {current_time}")
            
            # OpenWeatherMap API-Konfiguration
            api_key = self.config.get('weather', 'api_key', fallback=None)
            city = self.config.get('weather', 'city', fallback='Dresden')
            
            if not api_key:
                logger.warning("Kein OpenWeatherMap API-Key konfiguriert")
                self.temp_label.setText("🌡️ API-Key fehlt")
                return
                
            # API-Anfrage
            url = f"http://api.openweathermap.org/data/2.5/weather?q={city}&appid={api_key}&units=metric&lang=de"
            response = requests.get(url)
            
            if response.status_code == 200:
                data = response.json()
                
                # Extrahiere Wetterdaten
                temp = data['main']['temp']
                feels_like = data['main']['feels_like']
                humidity = data['main']['humidity']
                wind_speed = data['wind']['speed'] * 3.6  # Konvertiere m/s zu km/h
                clouds = data['weather'][0]['description']
                
                # Aktualisiere UI
                self.temp_label.setText(f"🌡️ Temperatur: {temp:.1f}°C")
                self.feel_label.setText(f"🌡️ Gefühlt: {feels_like:.1f}°C")
                self.clouds_label.setText(f"☁️ {clouds.capitalize()}")
                self.humidity_label.setText(f"💧 Luftfeuchtigkeit: {humidity}%")
                self.wind_label.setText(f"💨 Wind: {wind_speed:.1f} km/h")
                self.update_label.setText(f"Letzte Aktualisierung: {current_time}")
                
                logger.info(f"Wetterdaten erfolgreich aktualisiert für {city}")
            else:
                error_msg = f"API-Fehler: {response.status_code}"
                logger.error(error_msg)
                self.temp_label.setText("🌡️ API-Fehler")
                
        except requests.RequestException as e:
            logger.error(f"Netzwerkfehler bei Wetterabfrage: {e}")
            self.temp_label.setText("🌡️ Netzwerkfehler")
        except Exception as e:
            logger.error(f"Fehler beim Aktualisieren des Wetters: {e}")
            self.temp_label.setText("🌡️ Fehler")
            self.feel_label.setText("🌡️ Gefühlt: Fehler")
            self.clouds_label.setText("☁️ Fehler")
            self.humidity_label.setText("💧 Luftfeuchtigkeit: Fehler")
            self.wind_label.setText("💨 Wind: Fehler")
            self.update_label.setText("Letzte Aktualisierung: Fehler")

    def load_and_display_tasks(self):
        """Loads tasks from the manager and displays them in the list widget."""
        self.task_list_widget.clear()
        try:
            tasks = self.task_manager.list_tasks(status_filter="open")
            if not tasks:
                item = QListWidgetItem("Keine offenen Aufgaben")
                item.setForeground(QColor("#888"))
                item.setFlags(item.flags() & ~Qt.ItemFlag.ItemIsSelectable)
                self.task_list_widget.addItem(item)
            else:
                for task in tasks:
                    item = QListWidgetItem(task.get('description', 'N/A'))
                    item.setData(Qt.ItemDataRole.UserRole, task.get('id'))
                    self.task_list_widget.addItem(item)
        except Exception as e:
            logger.error(f"Fehler beim Laden und Anzeigen der Aufgaben: {e}")
            self.task_list_widget.addItem("Fehler beim Laden der Aufgaben")
            
    def add_new_task(self):
        """Adds a new task from the input field."""
        description = self.task_input_field.text().strip()
        if description:
            try:
                added_task = self.task_manager.add_task(description)
                if added_task:
                    self.task_input_field.clear()
                    self.load_and_display_tasks()
                else:
                    QMessageBox.warning(self, "Fehler", "Aufgabe konnte nicht hinzugefügt werden.")
            except Exception as e:
                logger.error(f"Fehler beim Hinzufügen der Aufgabe '{description}': {e}")
                QMessageBox.critical(self, "Fehler", f"Ein Fehler ist beim Hinzufügen aufgetreten:\n{e}")
                
    def get_selected_task_id(self) -> Optional[str]:
        """Returns the ID of the currently selected task in the list, or None."""
        selected_items = self.task_list_widget.selectedItems()
        if selected_items:
            item = selected_items[0]
            task_id = item.data(Qt.ItemDataRole.UserRole)
            return task_id
        return None
        
    def complete_selected_task(self):
        """Marks the selected task as done."""
        task_id = self.get_selected_task_id()
        if task_id:
            try:
                success = self.task_manager.mark_task_done(task_id)
                if success:
                    self.load_and_display_tasks()
                else:
                    QMessageBox.warning(self, "Fehler", "Ausgewählte Aufgabe konnte nicht als erledigt markiert werden.")
            except Exception as e:
                logger.error(f"Fehler beim Erledigen der Aufgabe ID {task_id}: {e}")
                QMessageBox.critical(self, "Fehler", f"Ein Fehler ist beim Erledigen aufgetreten:\n{e}")
        else:
            QMessageBox.information(self, "Hinweis", "Bitte zuerst eine Aufgabe auswählen.")
            
    def remove_selected_task(self):
        """Removes the selected task."""
        task_id = self.get_selected_task_id()
        if task_id:
            reply = QMessageBox.question(self, 'Aufgabe entfernen?', 
                                       f"Möchten Sie die ausgewählte Aufgabe wirklich entfernen?",
                                       QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No, 
                                       QMessageBox.StandardButton.No)

            if reply == QMessageBox.StandardButton.Yes:
                try:
                    success = self.task_manager.remove_task(task_id)
                    if success:
                        self.load_and_display_tasks()
                    else:
                        QMessageBox.warning(self, "Fehler", "Ausgewählte Aufgabe konnte nicht entfernt werden.")
                except Exception as e:
                    logger.error(f"Fehler beim Entfernen der Aufgabe ID {task_id}: {e}")
                    QMessageBox.critical(self, "Fehler", f"Ein Fehler ist beim Entfernen aufgetreten:\n{e}")
        else:
            QMessageBox.information(self, "Hinweis", "Bitte zuerst eine Aufgabe auswählen.")

    def import_files(self):
        """Öffnet einen Dialog zur Auswahl von Dateien für den Import."""
        try:
            file_paths, _ = QFileDialog.getOpenFileNames(
                self,
                "Dateien zum Importieren auswählen",
                "",
                "Alle Dateien (*);;Text Dateien (*.txt);;PDF Dateien (*.pdf);;Word Dateien (*.doc *.docx)"
            )
            
            if file_paths:
                self.on_update_chat("System", f"Starte Import von {len(file_paths)} Dateien...")
                # Starte den Import-Thread
                self.import_thread = KnowledgeImportThread(
                    file_paths=file_paths,
                    learning_manager=self.learning_manager,
                    parent=self
                )
                self.import_thread.update_status.connect(lambda msg: self.on_update_chat("System", msg))
                self.import_thread.import_finished.connect(self.on_import_finished)
                self.import_thread.start()
        except Exception as e:
            error_msg = f"Fehler beim Datei-Import: {str(e)}"
            logger.error(error_msg, exc_info=True)
            self.on_update_chat("System", error_msg)

    def show_prompt_editor(self):
        """Öffnet den Prompt-Editor."""
        try:
            editor = PromptEditor(self.config, self)
            editor.exec()
        except Exception as e:
            logger.error(f"Fehler beim Öffnen des Prompt-Editors: {e}")
            QMessageBox.critical(self, "Fehler", f"Fehler beim Öffnen des Prompt-Editors:\n{e}")

    def on_import_finished(self, success_count: int, total_count: int):
        """Wird aufgerufen, wenn der Import abgeschlossen ist."""
        try:
            # Aktualisiere die Datenbank-Statistiken
            db_size = get_directory_size("data/knowledge_base/chroma_db") / 1024  # Konvertiere zu MB
            
            if self.learning_manager and hasattr(self.learning_manager, 'collection'):
                # Hole die Anzahl der Einträge direkt aus der Collection
                total_entries = len(self.learning_manager.collection.get(
                    include=[],
                    limit=10000000  # Hoher Wert um alle Einträge zu bekommen
                )['ids'])
                
                # Zähle die verschiedenen Typen
                conversation_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "conversation"},
                    include=[]
                )['ids'])
                
                response_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "response"},
                    include=[]
                )['ids'])
                
                audio_transcript_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "audio_transcript_chunk"},
                    include=[]
                )['ids'])
                
                audiobook_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "audiobook_chunk"},
                    include=[]
                )['ids'])
                
                document_count = len(self.learning_manager.collection.get(
                    where={"entry_type": "document_chunk"},
                    include=[]
                )['ids'])
                
                # Aktualisiere das Label
                status_text = f"Datenbank: {db_size:.2f} MB | {total_entries} Einträge | conversation: {conversation_count} | response: {response_count} | audio_transcript_chunk: {audio_transcript_count} | audiobook_chunk: {audiobook_count} | document_chunk: {document_count}"
                self.db_status.setText(status_text)
                
                # Zeige Erfolgsmeldung
                QMessageBox.information(self, "Import abgeschlossen", 
                                      f"Import abgeschlossen: {success_count} von {total_count} Dateien erfolgreich importiert.")
            else:
                self.db_status.setText("Datenbank nicht verfügbar")
                QMessageBox.warning(self, "Import abgeschlossen", 
                                  f"Import abgeschlossen, aber Datenbank nicht verfügbar.")
                
        except Exception as e:
            logger.error(f"Fehler beim Aktualisieren der Import-Statistiken: {e}")
            QMessageBox.critical(self, "Fehler", f"Fehler beim Aktualisieren der Statistiken:\n{e}")

    def start_audio_recording(self):
        """
        Startet die Audioaufnahme mit dem ausgewählten Mikrofon.
        Initialisiert den AudioProcessor und startet den Aufnahme-Thread.
        """
        try:
            # Hole den ausgewählten Mikrofonindex
            mic_index = self.get_selected_microphone_index()
            if mic_index is None:
                raise ValueError("Kein Mikrofon ausgewählt")

            # Initialisiere den AudioProcessor
            self.audio_processor = AudioProcessor(mic_index)
            
            # Starte die Aufnahme
            self.audio_processor.start_recording()
            self.audio_visualizer.start_recording()
            
            # Starte den Timer für die Aufnahmedauer
            self.recording_timer.start(1000)  # Aktualisiere jede Sekunde
            self.recording_start_time = time.time()
            
            logging.info("Audioaufnahme gestartet")
            
        except Exception as e:
            error_msg = f"Fehler beim Starten der Audioaufnahme: {str(e)}"
            logging.error(error_msg)
            QMessageBox.critical(self, "Fehler", error_msg)
            raise

    def stop_audio_recording(self):
        """
        Stoppt die Audioaufnahme und gibt die aufgenommenen Audiodaten zurück.
        """
        try:
            if self.audio_processor:
                self.audio_processor.stop_recording()
                self.audio_visualizer.stop_recording()
                self.recording_timer.stop()
                logging.info("Audioaufnahme gestoppt")
            else:
                logging.warning("Versuch, die Aufnahme zu stoppen, aber kein AudioProcessor aktiv")
                
        except Exception as e:
            error_msg = f"Fehler beim Stoppen der Audioaufnahme: {str(e)}"
            logging.error(error_msg)
            QMessageBox.critical(self, "Fehler", error_msg)
            raise

    def import_audiobook(self):
        """Öffnet einen Dialog zur Auswahl eines Audiobooks."""
        try:
            folder_path = QFileDialog.getExistingDirectory(
                self,
                "Audiobook-Ordner auswählen",
                "",
                QFileDialog.Option.ShowDirsOnly
            )
            
            if folder_path:
                self.on_update_chat("System", f"Starte Import von Audiobook aus: {folder_path}")
                
                # Starte den Import-Thread
                self.import_thread = AudiobookImportThread(
                    folder_path=folder_path,
                    whisper_recognizer=self.whisper_recognizer,
                    learning_manager=self.learning_manager,
                    parent=self
                )
                
                # Verbinde die Signale
                self.import_thread.update_status.connect(lambda msg: self.on_update_chat("System", msg))
                self.import_thread.import_finished.connect(self.on_import_finished)
                
                # Starte den Thread
                self.import_thread.start()
                
        except Exception as e:
            error_msg = f"Fehler beim Importieren des Audiobooks: {str(e)}"
            logger.error(error_msg, exc_info=True)
            self.on_update_chat("System", error_msg)

    def import_folder(self):
        """Öffnet einen Dialog zur Auswahl eines Ordners für den Import."""
        try:
            folder_path = QFileDialog.getExistingDirectory(
                self,
                "Ordner zum Importieren auswählen",
                "",
                QFileDialog.Option.ShowDirsOnly
            )
            
            if folder_path:
                self.on_update_chat("System", f"Starte Import von Ordner: {folder_path}")
                # Hier würde der Import-Thread für den Ordner gestartet werden
                
        except Exception as e:
            error_msg = f"Fehler beim Importieren des Ordners: {str(e)}"
            logger.error(error_msg, exc_info=True)
            self.on_update_chat("System", error_msg)

    def import_media(self):
        """Öffnet einen Dialog zur Auswahl von Medien-Dateien."""
        try:
            file_paths, _ = QFileDialog.getOpenFileNames(
                self,
                "Medien-Dateien auswählen",
                "",
                "Alle Dateien (*);;Bilder (*.jpg *.png);;Videos (*.mp4);;Text (*.txt)"
            )
            
            if file_paths:
                self.on_update_chat("System", f"Starte Import von {len(file_paths)} Dateien")
                # Hier würde der Import-Thread für die Medien gestartet werden
                
        except Exception as e:
            error_msg = f"Fehler beim Importieren der Medien: {str(e)}"
            logger.error(error_msg, exc_info=True)
            self.on_update_chat("System", error_msg)

    def find_and_process_audio_in_folder(self, file_path, learning_manager, whisper_recognizer):
        """
        Verarbeitet eine einzelne Audiodatei und fügt sie zur Knowledge Base hinzu.
        
        Args:
            file_path (str): Pfad zur Audiodatei
            learning_manager (LearningManager): Instanz des LearningManagers
            whisper_recognizer (WhisperRecognizer): Instanz des WhisperRecognizers
        """
        try:
            # Transkribiere die Audiodatei
            transcript = whisper_recognizer.transcribe_wav(file_path)
            
            if transcript:
                # Erstelle Metadaten für das Dokument
                doc_id = str(uuid.uuid4())
                source_file = os.path.basename(file_path)
                timestamp = datetime.now().isoformat()
                
                # Füge das Transkript zur Knowledge Base hinzu
                learning_manager.add_to_knowledge_base(
                    text=transcript,
                    metadata={
                        "doc_id": doc_id,
                        "source_file": source_file,
                        "timestamp": timestamp,
                        "type": "audio_transcript"
                    }
                )
                print(f"Audiodatei erfolgreich verarbeitet: {file_path}")
            else:
                print(f"Warnung: Transkription fehlgeschlagen für {file_path}")
                
        except Exception as e:
            print(f"Fehler bei der Verarbeitung von {file_path}: {str(e)}")
            
class AudiobookImportThread(QThread):
    """Thread für den Import von Audiobüchern."""
    update_status = pyqtSignal(str)
    import_finished = pyqtSignal(int, int)

    def __init__(self, folder_path: str, whisper_recognizer: WhisperRecognizer, learning_manager: LearningManager, parent=None):
        super().__init__(parent)
        self.folder_path = folder_path
        self.whisper_recognizer = whisper_recognizer
        self.learning_manager = learning_manager
        self.log_prefix = "[AudiobookImportThread]"

    def run(self):
        """Führt den Import-Prozess aus."""
        try:
            logger.info(f"Starte Import von Audiobüchern aus: {self.folder_path}")
            self.update_status.emit("Starte Import...")
            
            # Prüfe ob Whisper Recognizer initialisiert ist
            if not self.whisper_recognizer:
                error_msg = "Whisper Recognizer ist nicht initialisiert. Bitte warten Sie, bis das Modell geladen ist."
                logger.error(f"{self.log_prefix} {error_msg}")
                self.update_status.emit(error_msg)
                self.import_finished.emit(0, 0)
                return
                
            success_count = 0
            total_count = 0
            
            # Verarbeite alle Audio-Dateien im Ordner
            for root, _, files in os.walk(self.folder_path):
                for file in files:
                    if file.lower().endswith(('.mp3', '.wav', '.m4a', '.flac')):
                        total_count += 1
                        try:
                            file_path = os.path.join(root, file)
                            self.update_status.emit(f"Verarbeite {file}...")
                            
                            # Rufe die Funktion mit allen erforderlichen Parametern auf
                            success = find_and_process_audio_in_folder(
                                file_path,
                                self.learning_manager,
                                self.whisper_recognizer
                            )
                            
                            if success:
                                success_count += 1
                                logger.info(f"Erfolgreich importiert: {file}")
                            else:
                                logger.warning(f"Fehler beim Import von: {file}")
                                
                        except Exception as e:
                            logger.error(f"Fehler bei der Verarbeitung von {file}: {e}")
                            
            logger.info(f"Import abgeschlossen. {success_count} von {total_count} Dateien erfolgreich importiert.")
            self.update_status.emit("Import abgeschlossen")
            self.import_finished.emit(success_count, total_count)
            
        except Exception as e:
            logger.error(f"Fehler beim Import-Prozess: {e}")
            self.update_status.emit(f"Fehler beim Import: {e}")
            self.import_finished.emit(0, 0)

def find_and_process_audio_in_folder(file_path: str, learning_manager, whisper_recognizer) -> bool:
    """
    Verarbeitet eine einzelne Audiodatei und fügt sie zur Wissensbasis hinzu.
    
    Args:
        file_path: Pfad zur Audiodatei
        learning_manager: Instance des LearningManager
        whisper_recognizer: Instance des WhisperRecognizer
    
    Returns:
        bool: True wenn erfolgreich, False wenn ein Fehler auftrat
    """
    try:
        # Transkribiere die Audio-Datei
        transcript = whisper_recognizer.transcribe_wav(file_path)
        
        if not transcript:
            logger.warning(f"Keine Transkription für: {file_path}")
            return False
            
        # Speichere das Transkript in der Wissensbasis
        learning_manager.add_entry(
            doc_id=str(uuid.uuid4()),
            content=transcript,
            metadata={
                "entry_type": "audiobook_chunk",
                "source": os.path.basename(file_path),
                "timestamp": datetime.now().isoformat()
            }
        )
        
        return True
        
    except Exception as e:
        logger.error(f"Fehler bei der Verarbeitung von {file_path}: {e}")
        return False

    def get_selected_microphone_index(self) -> Optional[int]:
        """Gibt den Index des aktuell ausgewählten Mikrofons zurück."""
        try:
            if hasattr(self, 'selected_mic_index') and self.selected_mic_index is not None:
                return self.selected_mic_index
                
            # Wenn kein Mikrofon ausgewählt ist, versuche ein Standardmikrofon zu finden
            self.select_default_microphone()
            return self.selected_mic_index
            
        except Exception as e:
            logger.error(f"Fehler beim Abrufen des Mikrofon-Index: {e}")
            return None

    def toggle_recording(self):
        """
        Startet oder stoppt die Audioaufnahme basierend auf dem aktuellen Aufnahmestatus.
        Aktualisiert die UI-Elemente entsprechend und behandelt mögliche Fehler.
        """
        try:
            if not self.is_recording:
                # Überprüfen, ob ein Mikrofon ausgewählt ist
                if self.get_selected_microphone_index() is None:
                    raise ValueError("Kein Mikrofon ausgewählt")
                
                # Starte die Aufnahme
                self.record_btn.setText("Aufnahme stoppen")
                self.is_recording = True
                self.start_audio_recording()
            else:
                # Stoppe die Aufnahme
                self.record_btn.setText("Aufnahme starten")
                self.is_recording = False
                self.stop_audio_recording()
                
        except Exception as e:
            logging.error(f"Fehler beim Umschalten der Aufnahme: {str(e)}")
            self.is_recording = False
            self.record_btn.setText("Aufnahme starten")
            QMessageBox.critical(self, "Fehler", f"Fehler beim Aufnahmevorgang: {str(e)}")

    def send_text_message(self):
        """Verarbeitet die Texteingabe und sendet sie an den LLM."""
        try:
            text = self.text_input.text().strip()
            if not text:
                return

            # Generiere eine eindeutige ID für diese Antwort
            response_id = str(uuid.uuid4())
            
            # Speichere den Kontext für River Learning
            self.interaction_context[response_id] = {"user_input": text}

            self.on_update_chat("Benutzer", text)
            self.text_input.clear()

            # Starte den Verarbeitungs-Thread
            self.processing_thread = TextProcessingThread(
                text=text,
                llm_manager=self.llm_manager,
                config=self.config,
                learning_manager=self.learning_manager,
                river_learning_manager=self.river_learning_manager,
                response_id=response_id,
                parent=self
            )
            
            # Verbinde die Signale
            self.processing_thread.update_chat.connect(self.on_update_chat)
            self.processing_thread.trigger_tts.connect(self.on_trigger_tts)
            self.processing_thread.processing_finished.connect(self.on_processing_finished)
            
            # Starte den Thread
            self.processing_thread.start()
            
        except Exception as e:
            error_msg = f"Fehler bei der Verarbeitung der Texteingabe: {str(e)}"
            logger.error(error_msg, exc_info=True)
            self.on_update_chat("System", error_msg)